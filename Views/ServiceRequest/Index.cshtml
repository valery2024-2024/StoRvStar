@model List<StoRvStar.Models.ViewModels.ServiceRequestItemVM>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Список заявок</h2>

        <a asp-controller="ServiceRequest" asp-action="Create" class="btn btn-primary">
            + Нова заявка
        </a>
    </div>

    <table class="table table-bordered table-hover shadow">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Клієнт</th>
                <th>Авто</th>
                <th>Послуги</th>
                <th>Сума</th>
                <th>Статус</th>
                <th>Дата</th>
                <th>Дії</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Id</td>

                    <td>
                        @r.ClientName <br />
                        <small>@r.ClientPhone</small>
                    </td>

                    <td>
                        <b>@r.CarName</b><br />
                        <small>@r.PlateNumber</small>
                    </td>

                    <td>
                        @foreach (var serviceName in r.Services)
                        {
                            <span class="badge bg-secondary me-1">
                                @serviceName
                            </span>
                        }
                    </td>

                    <td>
                        <span class="fw-bold text-success">
                            @($"{r.TotalPrice} грн")
                        </span>
                    </td>

                    <td>
                        @{
                            var statusClass = r.Status switch
                            {
                                "New" => "bg-primary",
                                "InProgress" => "bg-warning text-dark",
                                "Done" => "bg-success",
                                _ => "bg-secondary"
                            };
                        }

                        <span class="badge @statusClass">
                            @r.StatusText
                        </span>
                    </td>

                    <td>
                        @r.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td>
                        @if (r.Status == "New")
                        {
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="hidden" name="status" value="InProgress" />
                                <button type="submit" class="btn btn-sm btn-warning mb-1">В роботу</button>
                            </form>
                        }
                        else if (r.Status == "InProgress")
                        {
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="hidden" name="status" value="Done" />
                                <button type="submit" class="btn btn-sm btn-success mb-1">Завершити</button>
                            </form>
                        }
                        else
                        {
                            <div class="text-muted mb-1">Готово</div>
                        }

                        <a asp-controller="ServiceRequest" asp-action="Details" asp-route-id="@r.Id"
                           class="btn btn-sm btn-info mb-1 text-white">
                            Деталі
                        </a>

                        <a asp-controller="ServiceRequest" asp-action="Edit" asp-route-id="@r.Id"
                           class="btn btn-sm btn-outline-primary mb-1">
                            Редагувати
                        </a>

                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Видалити заявку?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
